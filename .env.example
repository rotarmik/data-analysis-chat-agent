# GCP / BigQuery
GCP_PROJECT_ID=your-gcp-project-id

# Ollama Cloud (https://ollama.com -> Settings -> API Keys)
OLLAMA_API_KEY=your-ollama-cloud-key
OLLAMA_HOST=https://ollama.com
OLLAMA_MODEL=kimi-k3:cloud
OLLAMA_FALLBACK_MODEL=gpt-oss:120b-cloud

# Langfuse observability (optional — leave empty to use local JSONL traces only)
# Keys: Langfuse UI -> Settings -> API Keys
# LANGFUSE_PUBLIC_KEY=pk-lf-...
# LANGFUSE_SECRET_KEY=sk-lf-...
# LANGFUSE_HOST=https://cloud.langfuse.com

# Docker only (Windows): path to your ADC file on the host
# ADC_PATH=C:\Users\<you>\AppData\Roaming\gcloud\application_default_credentials.json
